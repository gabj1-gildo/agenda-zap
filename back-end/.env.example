# ==========================================
# BANCO DE DADOS (POSTGRES / SUPABASE)
# ==========================================
DATABASE_URL="postgresql://user:password@host:6543/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ==========================================
# INTEGRAÇÃO WHATSAPP (EVOLUTION API)
# ==========================================
EVOLUTION_API_URL="https://your-evolution-api-url"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE_NAME="whatsapp-vendas"

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (GEMINI)
# ==========================================
GEMINI_API_KEY="your-gemini-api-key"

# ==========================================
# GOOGLE CALENDAR
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"

# ==========================================
# GATEWAYS DE PAGAMENTO (ASAAS E MERCADO PAGO)
# ==========================================
# Asaas (Usado para Cartões e Roteamento de Valores Altos no PIX/Boleto)
ASAAS_API_URL="https://api-sandbox.asaas.com/v3" # Mude para "https://api.asaas.com/v3" em produção
ASAAS_API_KEY="your-asaas-api-key"

# Mercado Pago (Usado para roteamento PIX de valores baixos)
MP_ACCESS_TOKEN="your-mercadopago-access-token"
MP_CLIENT_ID="your-mercadopago-client-id"
MP_CLIENT_SECRET="your-mercadopago-client-secret"
MP_REDIRECT_URI="https://your-domain.com/api/mercadopago/callback"
MP_SUCCESS_URL="https://seusite.com.br/sucesso"
MP_FAILURE_URL="https://seusite.com.br/falha"

# ==========================================
# REDIS / CACHE
# ==========================================
# Usado para Debounce, Rate Limiting e Filas de Mensagem
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ==========================================
# SERVIÇOS DE E-MAIL (RESEND)
# ==========================================
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ==========================================
# SEGURANÇA E AMBIENTE
# ==========================================
JWT_SECRET="your-backend-jwt-secret"
ARGON2_SECRET="your-argon2-secret-pepper"

# URL Base para receber Webhooks (usar Ngrok localmente)
APP_URL="https://your-domain.com"

# URL do Front-end (usado para redirecionamento após OAuth/Pagamento)
FRONTEND_URL="http://localhost:3000"
