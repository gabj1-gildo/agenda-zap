FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .

# Receber possíveis ARGs de ambiente do Easypanel para o build do Next.js
ARG DATABASE_URL
ARG JWT_SECRET
ARG R2_ACCESS_KEY_ID
ARG R2_SECRET_ACCESS_KEY
ARG R2_ENDPOINT
ARG R2_BUCKET_NAME
ARG R2_PUBLIC_URL
ARG RESEND_API_KEY
ARG ABACATEPAY_API_KEY
ARG MP_ACCESS_TOKEN
ARG GEMINI_API_KEY
ARG FRONTEND_URL
ARG WEBHOOK_SECRET_MP
ARG WEBHOOK_SECRET_ABACATEPAY
ARG GIT_SHA

# Exportar como variáveis de ambiente para a fase de build e runtime
ENV DATABASE_URL=$DATABASE_URL \
    JWT_SECRET=$JWT_SECRET \
    R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID \
    R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY \
    R2_ENDPOINT=$R2_ENDPOINT \
    R2_BUCKET_NAME=$R2_BUCKET_NAME \
    R2_PUBLIC_URL=$R2_PUBLIC_URL \
    RESEND_API_KEY=$RESEND_API_KEY \
    ABACATEPAY_API_KEY=$ABACATEPAY_API_KEY \
    MP_ACCESS_TOKEN=$MP_ACCESS_TOKEN \
    GEMINI_API_KEY=$GEMINI_API_KEY \
    FRONTEND_URL=$FRONTEND_URL \
    WEBHOOK_SECRET_MP=$WEBHOOK_SECRET_MP \
    WEBHOOK_SECRET_ABACATEPAY=$WEBHOOK_SECRET_ABACATEPAY \
    GIT_SHA=$GIT_SHA

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
